# Optional: raises GitHub rate limits and enables private repository access.
GITHUB_TOKEN=

# Hash a generated API key with app.security.hash_api_key before configuring it.
API_KEY_HASH=

# Analyzer runtime
GITHUB_API_URL=https://api.github.com
REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256
DATABASE_PATH=devlens.db
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000
MAX_CONTEXT_FILE_BYTES=100000
